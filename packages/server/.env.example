# Copia este archivo a .env y ajusta los valores.

# Entorno de ejecución. Fuera de "production" se regenera el cliente OpenAPI al arrancar.
NODE_ENV=development

# Puerto en el que escucha el servidor (por defecto 3000).
PORT=3000

# Conexión a Postgres. Estos valores coinciden con el compose.yaml de la raíz (solo desarrollo).
DATABASE_URL=postgres://uptime:uptime_dev@localhost:5432/uptime
